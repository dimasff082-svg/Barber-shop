# ==============================================================================
# ENVIRONMENT VARIABLES UNTUK VERCEL DEPLOYMENT (BARBERFLOW)
# Salin variabel ini ke Project Settings > Environment Variables di dashboard Vercel
# ==============================================================================

# Identitas Aplikasi
APP_NAME=BARBERFLOW
APP_ENV=production
APP_DEBUG=false
# Masukkan URL deployment Vercel Anda, contoh: https://barberflow.vercel.app
APP_URL=https://ganti-dengan-domain-vercel-anda.vercel.app

# Kunci Enkripsi Aplikasi (Wajib diisi!)
# Dapatkan dengan menjalankan: php artisan key:generate --show
APP_KEY=

# Zona Waktu Usaha (default: Asia/Makassar)
BARBERFLOW_TIMEZONE=Asia/Makassar
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Koneksi Database PostgreSQL (Wajib!)
# Disarankan menggunakan cloud PostgreSQL seperti Neon.tech, Supabase, atau Railway.
# Opsi 1: Menggunakan connection string lengkap (DB_URL)
# DB_URL=postgres://user:password@ep-xyz.neon.tech/neondb?sslmode=require
#
# Opsi 2: Parameter individual
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SCHEMA=public
DB_SSLMODE=require

# Session & Cache (Menggunakan tabel PostgreSQL database)
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database

# Antrean & Logging untuk Serverless
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Realtime / Broadcasting
# Default 'null' (polling fallback di frontend tetap aktif otomatis sekitar 12 detik)
# Jika ingin WebSocket aktif di production, gunakan akun Pusher:
BROADCAST_CONNECTION=null
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_APP_CLUSTER=ap1

# Penyimpanan Berkas Upload (Opsional jika ingin menyimpan foto upload secara persisten di S3 / Cloudflare R2 / Supabase Storage)
FILESYSTEM_DISK=public
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=

# Keamanan Cron Vercel (Otomatis menandai antrean lewat waktu)
CRON_SECRET=barberflow-cron-secret-acak-anda

